# .env.example
NODE_ENV=development
PORT=3000

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=nestjs
POSTGRES_SSL=false

# JWT Configuration
JWT_SECRET=your-jwt-access-secret-key-here-make-this-long-and-random
JWT_EXPIRATION_TIME=3600
# JWT_ACCESS_TOKEN_SECRET=your-jwt-access-secret-key-here-make-this-long-and-random
# JWT_ACCESS_TOKEN_EXPIRATION_TIME=3600
# JWT_REFRESH_TOKEN_SECRET=your-jwt-refresh-secret-key-here-make-this-different-and-long
# JWT_REFRESH_TOKEN_EXPIRATION_TIME=604800

# # Google OAuth (Optional)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# # Rate Limiting
# THROTTLE_TTL=60
# THROTTLE_LIMIT=100

